{
  "name": "天汇基金 OFC 平台",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:18",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "18"
    }
  },
  "forwardPorts": [3000, 5173],
  "portsAttributes": {
    "3000": {
      "label": "后端 API",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "前端应用",
      "onAutoForward": "openBrowser"
    }
  },
  "postCreateCommand": "cd demo/backend && npm install && npm run db:init && npm run db:seed && cd ../frontend && npm install",
  "postStartCommand": "cd demo/backend && npm run dev & cd demo/frontend && npm run dev",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  }
}
