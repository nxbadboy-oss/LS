# 环境配置
NODE_ENV=production

# 服务器端口
PORT=3000

# 跨域配置 - 设置为您的前端域名
# 开发环境: http://localhost:5173
# 生产环境: https://your-frontend.vercel.app
CORS_ORIGIN=http://localhost:5173

# JWT 密钥 - 生产环境必须修改为强随机密钥
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=please-change-this-to-a-random-secret-key-in-production

# 数据库路径（可选，默认为 ./database/demo.db）
# DATABASE_PATH=./database/demo.db

# 日志级别（可选，默认为 info）
# LOG_LEVEL=info
