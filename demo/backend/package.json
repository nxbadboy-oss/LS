{
  "name": "tianhuifund-backend-demo",
  "version": "0.1.0",
  "description": "天汇基金 OFC 平台后端演示版",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:init": "tsx src/database/init.ts",
    "db:seed": "tsx src/database/seed.ts",
    "db:reset": "rm -f database/demo.db && npm run db:init && npm run db:seed",
    "db:init:v2": "tsx src/database/init-v2.ts",
    "db:seed:v2": "tsx src/database/seed-v2.ts",
    "db:upgrade": "rm -f database/demo.db && npm run db:init:v2 && npm run db:seed:v2"
  },
  "keywords": ["fund", "ofc", "demo"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.2.2",
    "express-validator": "^7.0.1",
    "morgan": "^1.10.0",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.8",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.6",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
